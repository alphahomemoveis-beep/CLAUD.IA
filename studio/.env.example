# Copie para .env.local e preencha. Nada aqui vai para o navegador.

# Banco PostgreSQL com pgvector
DATABASE_URL=postgres://studio:studio@localhost:5432/alphahome_studio

# Provedor de IA: "openai" em produção, "mock" para testar o fluxo sem custo
AI_PROVIDER=openai
OPENAI_API_KEY=

# Modelos (troque sem mexer no código)
AI_TEXT_MODEL=gpt-5.5
AI_VISION_MODEL=gpt-5.5
AI_IMAGE_MODEL=gpt-image-2.5-sunburst
AI_EMBEDDING_MODEL=text-embedding-3-small

# Armazenamento de arquivos: "local" ou "supabase"
STORAGE_DRIVER=local
STORAGE_DIR=./data/uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=alphahome-studio

# Sessão e limites
SESSION_DAYS=14
MAX_UPLOAD_MB=25
# URL pública do app, usada na checagem de origem das requisições
APP_URL=http://localhost:3000

# Primeiro acesso (usado por npm run db:seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=AlphaHome
