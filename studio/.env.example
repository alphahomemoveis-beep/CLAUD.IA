# Copie para .env.local e preencha. Nada aqui vai para o navegador.

# Banco PostgreSQL com pgvector
DATABASE_URL=postgres://studio:studio@localhost:5432/alphahome_studio
# Certificado do banco (Supabase: Database > Settings > SSL Configuration). Conteúdo PEM completo.
DATABASE_CA_CERT=

# Cérebro do estúdio: "anthropic" (Claude, padrão), "openai" ou "mock" (teste sem custo)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Opcional: troque o modelo sem mexer no código (padrão: claude-opus-5-5)
AI_TEXT_MODEL=
AI_VISION_MODEL=

# Imagens: o Claude não gera imagens.
#   manual = o app entrega o prompt final e você envia a imagem pronta (padrão)
#   openai = gera pela Image API da OpenAI (exige OPENAI_API_KEY só para imagens)
IMAGE_PROVIDER=manual
AI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_API_KEY=

# Busca de referências: "none" usa texto completo no PostgreSQL (padrão),
# "voyage" usa embeddings do Voyage AI (parceiro recomendado pela Anthropic)
EMBEDDING_PROVIDER=none
VOYAGE_API_KEY=

# Armazenamento de arquivos: "local" ou "supabase"
STORAGE_DRIVER=local
STORAGE_DIR=./data/uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=alphahome-studio

# Endereço público do app (checagem de origem e links de mídia para o Metricool)
APP_URL=http://localhost:3000
# Pelo menos 32 caracteres aleatórios. Gere com: openssl rand -hex 32
APP_SECRET=
APP_TIMEZONE=America/Sao_Paulo

# Metricool: agenda e publica os posts (plano com acesso à API)
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
# Opcional: nomes das séries de métricas no Metricool
# METRICOOL_TIMELINE_METRICS=followers:igFollowers,reach:igReach,impressions:igImpressions

# Windsor.ai: métricas do Instagram da marca para o jornal
WINDSOR_API_KEY=
# Opcional: campos pedidos ao Windsor
# WINDSOR_INSTAGRAM_FIELDS=date,account_id,user_name,followers_count,reach,impressions,profile_views,media_count

# Sincronização automática: chame /api/cron/sync com Authorization: Bearer CRON_SECRET
CRON_SECRET=

# Sessão e limites
SESSION_DAYS=14
MAX_UPLOAD_MB=25
FOLDER_MAX_UPLOAD_MB=300

# Primeiro acesso também pode ser feito pela tela /primeiro-acesso
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=AlphaHome
